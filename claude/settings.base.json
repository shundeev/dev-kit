{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(bb *)",
      "Bash(jq *)",
      "Bash(bash .claude/skills/gh-project-workflow/scripts/*.sh *)",
      "Bash({{kit}}/bin/kit *)"
    ],
    "ask": [
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)"
    ],
    "deny": [
      "Bash(gh repo delete *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/session-start.sh\"; [ -r \"$h\" ] || { echo \"dev-kit is not checked out ({{kit}}/ is empty). Tell the owner to run: git submodule update --init && {{kit}}/bin/kit init\"; exit 0; }; exec bash \"$h\"'",
            "timeout": 30,
            "statusMessage": "Checking dev-kit setup..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/delivery-guard.sh\"; [ -r \"$h\" ] || exit 0; exec bash \"$h\"'",
            "timeout": 10,
            "statusMessage": "Checking delivery flow..."
          }
        ]
      }
    ]
  }
}
