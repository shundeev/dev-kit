{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git merge-base *)",
      "Bash(git remote -v)",
      "Bash(git remote get-url *)",
      "Bash(git config --get *)",
      "Bash(git config --local --get *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git switch *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git submodule status *)",
      "Bash(git submodule update *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue develop *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh repo view *)",
      "Bash(gh label list *)",
      "Bash(gh auth status *)",
      "Bash(gh project view *)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(bash .claude/skills/gh-project-workflow/scripts/start_issue_flow.sh *)",
      "Bash(bash .claude/skills/gh-project-workflow/scripts/finish_issue_flow.sh *)",
      "Bash(bash .claude/skills/gh-project-workflow/scripts/merge_issue_flow.sh *)",
      "Bash({{kit}}/bin/kit *)",
      "Bash(bb {{kit}}/bin/kit *)",
      "Bash(jq *)"
    ],
    "ask": [
      "Bash(* --skip-retro*)",
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(gh pr close *)",
      "Bash(gh pr merge *)",
      "Bash(gh project item-delete *)",
      "Bash(gh release *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh workflow run *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -b *)",
      "Bash(git clean *)",
      "Bash(git push * --delete *)",
      "Bash(git push --delete *)",
      "Bash(git reset --hard *)",
      "Bash(git restore *)",
      "Bash(git switch -c *)"
    ],
    "deny": [
      "Bash(gh repo delete *)",
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git push * +*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/session-start.sh\"; [ -r \"$h\" ] || { echo \"dev-kit is not checked out ({{kit}}/ is empty). Tell the owner to run: git submodule update --init && {{kit}}/bin/kit init\"; exit 0; }; exec bash \"$h\"'",
            "timeout": 30,
            "statusMessage": "Checking dev-kit setup..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pretooluse.sh\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking delivery flow..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/friction.sh\"; [ -r \"$h\" ] && exec bash \"$h\" PreToolUse; exit 0'"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/friction.sh\"; [ -r \"$h\" ] && exec bash \"$h\" PermissionRequest; exit 0'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/friction.sh\"; [ -r \"$h\" ] && exec bash \"$h\" PostToolUse; exit 0'"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "statusMessage": "Formatting with the project's zprint configuration...",
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/format.sh\"; [ -r \"$h\" ] && exec bash \"$h\"; exit 0'"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/friction.sh\"; [ -r \"$h\" ] && exec bash \"$h\" PostToolUseFailure; exit 0'"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/friction.sh\"; [ -r \"$h\" ] && exec bash \"$h\" PermissionDenied; exit 0'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/friction.sh\"; [ -r \"$h\" ] && exec bash \"$h\" UserPromptSubmit; exit 0'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/friction.sh\"; [ -r \"$h\" ] && exec bash \"$h\" Stop; exit 0'"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/friction.sh\"; [ -r \"$h\" ] && exec bash \"$h\" SubagentStop; exit 0'"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "bash -c 'h=\"${CLAUDE_PROJECT_DIR:-.}/{{kit}}/claude/hooks/friction.sh\"; [ -r \"$h\" ] && exec bash \"$h\" StopFailure; exit 0'"
          }
        ]
      }
    ]
  }
}
