#!/usr/bin/env bb
;; dev-kit: lays out and checks the shared setup of a project that mounts dev-kit at .shared
;;
;;   .shared/bin/kit init     [--repo owner/name] [--showcase NAME] [--modules clojure] [--scaffold]
;;   .shared/bin/kit init     --local   per-machine items only (the SessionStart hook runs it)
;;   .shared/bin/kit doctor   [--ci] [--quiet]
;;   .shared/bin/kit modules
;;   .shared/bin/kit user-test   the project's user-level test, :user-test in kit.edn (#27)
;;   .shared/bin/kit identity [--dir PATH]   the agent's GitHub identity alone, for any repository
;;   .shared/bin/kit gate     --branch B --pr N | --g1 N | --hook   the pull request gate (ADR-0002, #21)
;;                            | --shape --branch B --title T [--body-file F]   its shape rules, offline
;;   .shared/bin/kit retro    N [--repo R] [--messages]   friction data of merged issue N for its
;;                            retrospective: the friction log the hooks keep on this machine, and GitHub (#55)
;;   .shared/bin/kit retro    --missing [--repo R]   merged issues of the last 14 days without a retrospective;
;;                            exit 1 when there are some (#56)
;;
;; Two kinds of files:
;;   scaffold — created once if missing, then owned by the project (kit.edn, LICENSE, the
;;              project part of AGENTS.md; with --scaffold also README.md, adr/, docs/experiments/)
;;   managed  — owned by dev-kit, rewritten by init, verified by doctor (the AGENTS.md block,
;;              .claude/settings.json, .claude/skills links, .claude/agents copies,
;;              .github/workflows/ci.yml, .github/CODEOWNERS, the issue form and PR template,
;;              clojure module: .zprint.edn link, clj-kondo config-paths;
;;              per machine and git-ignored: the agent identity env in .claude/settings.local.json)
(ns kit
  (:require
    [babashka.fs :as fs]
    [babashka.process :as p]
    [cheshire.core :as json]
    [clj-yaml.core :as yaml]
    [clojure.edn :as edn]
    [clojure.string :as str]
    [rewrite-clj.parser :as rewrite-parser]
    [rewrite-clj.zip :as z]))


(def kit-dir (-> *file* fs/absolutize fs/normalize fs/parent fs/parent))
(def mount (str (fs/file-name kit-dir)))
(def root (fs/parent kit-dir))


(defn die
  [& msg]
  (binding [*out* *err*] (println (str "kit: " (str/join " " msg))))
  (System/exit 2))


(defn sh-in
  "Runs a command in dir. Returns trimmed stdout, or nil when it fails."
  [dir & args]
  (let [{:keys [exit out]} (apply p/sh {:dir (str dir) :continue true} args)]
    (when (zero? exit) (str/trim out))))


(defn sh
  "Runs a command in the project root. Returns trimmed stdout, or nil when it fails."
  [& args]
  (apply sh-in root args))


(defn rel [& parts] (str (apply fs/path root parts)))


(defn slurp-if [path] (when (fs/regular-file? path) (slurp path)))


;; ------------------------------------------------------------------ config

(def config-file (rel "kit.edn"))


(defn read-defaults [] (edn/read-string (slurp (str (fs/path kit-dir "kit-defaults.edn")))))


(defn fail!
  "A problem the person fixes: kit prints the message, without a stack trace, and exits 1."
  [& msg]
  (throw (ex-info (str/join " " msg) {:kit/problem true})))


(defn merge-config
  "kit.edn over the defaults: a key replaces the default, except :board, whose :owner and :number merge one by one
  (#14). :agent replaces whole, so one account's login never pairs with another's email."
  [defaults m]
  (cond-> (merge defaults m)
    (and (map? (:board defaults)) (map? (:board m))) (assoc :board (merge (:board defaults) (:board m)))))


(defn read-config
  "kit.edn over the defaults, or nil when there is none."
  []
  (when-let [s (slurp-if config-file)]
    (let [m (try (edn/read-string s)
                 (catch Exception e
                   (let [why (or (try (rewrite-parser/parse-string-all s) nil (catch Exception e2 (ex-message e2))) (ex-message e))
                         [_ msg line] (re-find #"(.*) \[at line (\d+), column \d+\]" why)]
                     (fail! (str "kit.edn" (when line (str " line " line)) " cannot be read (" (or msg why) "): fix it by hand")))))]
      (when-not (map? m) (fail! "kit.edn is not a map: make it {:repo \"owner/name\" :showcase \"…\" :modules #{}}"))
      (merge-config (read-defaults) m))))


(def known-modules #{:clojure})


(defn config-problems
  "What is wrong with kit.edn over the defaults, each naming the key and the fix (#14)."
  [{:keys [repo showcase modules base owners board agent user-test]}]
  (let [unknown   (when (coll? modules) (remove known-modules modules))
        run       (when (map? user-test) (:run user-test))
        artifacts (when (map? user-test) (:artifacts user-test))]
    (cond-> []
      (not (and (string? repo) (re-matches #"[^/\s]+/[^/\s]+" repo)))
      (conj (str ":repo is " (pr-str repo) ", not \"owner/name\": set it in kit.edn (kit init --repo owner/name in a new project)"))

      (not (and (string? showcase) (not (str/blank? showcase))))
      (conj (str ":showcase is missing: set it in kit.edn to the board's Showcase option for this project"
                 " (kit init --showcase <option> in a new project)"))

      (not (coll? modules)) (conj ":modules must be a set, e.g. #{} or #{:clojure}")

      (seq unknown)
      (conj (str ":modules has " (str/join ", " (map pr-str unknown)) "; known modules: "
                 (str/join ", " (map name (sort known-modules)))))

      (not (and (string? base) (not (str/blank? base)))) (conj ":base must name the base branch, e.g. \"main\"")

      (not (and (sequential? owners) (seq owners) (every? string? owners)))
      (conj ":owners must list who reviews every change, e.g. [\"shundeev/owners\"]")

      (not (and (string? (:owner board)) (int? (:number board)))) (conj ":board must be {:owner \"login\" :number N}")

      (not (or (nil? agent) (and (map? agent) (every? #(string? (get agent %)) [:login :email :gh-config-dir]))))
      (conj ":agent must be nil, or a map with :login, :email and :gh-config-dir (the agent's account; see kit-defaults.edn)")

      (not (or (nil? user-test) (and (string? run) (not (str/blank? run)))))
      (conj (str ":user-test must be nil, or {:run \"<command>\" :artifacts \"<folder>\"} with :run the command of the"
                 " project's user-level test (#27, docs/user-level-tests.md)"))

      ;; A plain path: upload-artifact reads *, !, ~ and the like as patterns, and "." would be the whole checkout.
      (not (or (nil? artifacts)
               (and (string? artifacts) (re-matches #"[A-Za-z0-9_][A-Za-z0-9._/-]*" artifacts)
                    (not-any? #{".."} (str/split artifacts #"/")))))
      (conj (str ":user-test :artifacts is " (pr-str artifacts) ": it must be a folder inside the project, named with"
                 " letters, digits, . _ - and /, e.g. \"test-results\"")))))


(defn clojure? [cfg] (contains? (set (:modules cfg)) :clojure))


(defn user-test!
  "Runs the project's user-level test, :user-test :run in kit.edn, from the project's root, and exits with its code
  (#27). CI runs it inside the `checks` job, after the other checks."
  []
  (let [cfg (or (read-config) (fail! "no kit.edn: run .shared/bin/kit init first"))
        _   (some->> (seq (config-problems cfg)) (map #(str "kit.edn: " %)) (str/join "; ") fail!)
        run (get-in cfg [:user-test :run])]
    (when-not run
      (fail! "kit.edn has no :user-test: add :user-test {:run \"<the command of the user-level test>\""
             ":artifacts \"<the folder it writes>\"} (docs/user-level-tests.md in dev-kit)"))
    (println (str "user-level test: " run))
    (flush)
    (System/exit (:exit @(p/process {:dir (str root) :inherit true} "bash" "-c" run)))))


;; ------------------------------------------------------------------ expected state

(def block-begin
  (str "<!-- dev-kit:begin — generated from " mount "/rules by " mount
       "/bin/kit init. Edit it in dev-kit, not here. -->"))


(def block-end "<!-- dev-kit:end -->")


(defn block-text
  [cfg]
  (str block-begin "\n\n"
       (slurp (str (fs/path kit-dir "rules" "shared.md")))
       (when (clojure? cfg)
         (str "\n" (slurp (str (fs/path kit-dir "rules" "clojure.md")))))
       "\n" block-end))


(defn deep-merge
  [a b]
  (cond (and (map? a) (map? b)) (merge-with deep-merge a b)
        (and (sequential? a) (sequential? b)) (vec (distinct (concat a b)))
        (nil? b) a
        :else b))


(defn json-text
  [m]
  (str (json/generate-string m {:pretty {:indentation 2
                                         :indent-arrays? true
                                         :object-field-value-separator ": "}})
       "\n"))


(defn settings-text
  [cfg]
  (let [base (-> (slurp (str (fs/path kit-dir "claude" "settings.base.json")))
                 (str/replace "{{kit}}" mount)
                 (json/parse-string))
        clj  (when (clojure? cfg)
               {"permissions" {"allow" ["Bash(clj-kondo *)" "Bash(zprint *)"
                                        (str "Bash(" mount "/clojure/zprint_check.sh *)")
                                        (str "Bash(bb " mount "/clojure/single_caller.clj *)")
                                        (str "Bash(bb " mount "/clojure/field_of_same_map.clj *)")]}})
        env  {"env" (into (sorted-map)
                          (remove (comp nil? val))
                          {"GHWF_OWNER"          (get-in cfg [:board :owner])
                           "GHWF_PROJECT_NUMBER" (some-> (get-in cfg [:board :number]) str)
                           "GHWF_REPO"           (:repo cfg)
                           "GHWF_DEFAULT_BASE"   (:base cfg)
                           "GHWF_SHOWCASE"       (:showcase cfg)
                           "GHWF_REVIEWERS"      (some->> (seq (:owners cfg)) (str/join ","))})}]
    (json-text (deep-merge (deep-merge (deep-merge base clj) env)
                           (json/parse-string (json/generate-string (:claude-settings cfg {})))))))


;; ------------------------------------------------------------------ agent identity
;; The agent works under its own GitHub account (kit.edn :agent), so the main ruleset's required
;; review is a review by the owner. Claude Code applies settings env to the session, its hooks
;; and every command it runs; the owner's own terminal is untouched.

(def local-settings ".claude/settings.local.json")


(defn expand-home
  "~ as the shell and gh read it: from HOME, not from the JVM's user.home."
  [path]
  (str/replace-first (str path) #"^~(?=/|$)"
                     (str/re-quote-replacement (or (not-empty (System/getenv "HOME")) (System/getProperty "user.home")))))


(defn agent-env
  [{:keys [login email gh-config-dir]}]
  {"GH_CONFIG_DIR"       (expand-home gh-config-dir)
   ;; git takes config from the environment too: SSH remotes go over HTTPS, and the github.com
   ;; credential helpers are reset to gh alone, which answers with GH_CONFIG_DIR's login.
   "GIT_CONFIG_COUNT"    "3"
   "GIT_CONFIG_KEY_0"    "url.https://github.com/.insteadOf"
   "GIT_CONFIG_VALUE_0"  "git@github.com:"
   "GIT_CONFIG_KEY_1"    "credential.https://github.com.helper"
   "GIT_CONFIG_VALUE_1"  ""
   "GIT_CONFIG_KEY_2"    "credential.https://github.com.helper"
   "GIT_CONFIG_VALUE_2"  "!gh auth git-credential"
   "GIT_AUTHOR_NAME"     login
   "GIT_AUTHOR_EMAIL"    email
   "GIT_COMMITTER_NAME"  login
   "GIT_COMMITTER_EMAIL" email})


(defn read-json-object
  "The JSON object in file f: {} when the file is missing, ::invalid when it holds no object."
  [f]
  (if-let [s (slurp-if f)]
    (let [m (try (json/parse-string s) (catch Exception _ nil))]
      (if (map? m) m ::invalid))
    {}))


(declare gh-login)


(defn human-login
  "The person behind the agent on this machine: their own gh login (the default gh config, never
  GH_CONFIG_DIR, which points at the agent). Their PRs are assigned to them (#52)."
  []
  (gh-login (or (some-> (not-empty (System/getenv "XDG_CONFIG_HOME")) (fs/path "gh") str)
                (expand-home "~/.config/gh"))))


(defn local-env-problem
  [dir env]
  (let [f (str (fs/path dir local-settings))
        m (read-json-object f)]
    (cond (not (fs/exists? f)) "missing"
          (= ::invalid m) "is not a JSON object"
          (not= env (select-keys (get m "env") (keys env))) "env differs from the agent identity in kit.edn"
          (and (human-login) (str/blank? (get-in m ["env" "GHWF_HUMAN"])))
          "lacks GHWF_HUMAN, the person behind the agent")))


(defn write-local-env!
  "Merges env into the file's env; every other key, the owner's own, stays."
  [dir env]
  (let [f (str (fs/path dir local-settings))
        m (read-json-object f)]
    (when (= ::invalid m) (fail! local-settings "is not a JSON object; fix or remove it, then run again"))
    (fs/create-dirs (fs/parent f))
    (spit f (json-text (update m "env" #(into (sorted-map)
                                              (merge % env
                                                     (when-let [h (human-login)]
                                                       (when (str/blank? (get % "GHWF_HUMAN")) {"GHWF_HUMAN" h})))))))))


(defn ignored-problem
  [dir path]
  (when-not (sh-in dir "git" "check-ignore" "-q" path) "is not git-ignored, so it could be committed"))


(defn ignore!
  "Adds path to the repository's info/exclude: per clone, shared by its worktrees."
  [dir path]
  (let [ex (or (sh-in dir "git" "rev-parse" "--path-format=absolute" "--git-path" "info/exclude")
               (die (str dir) "is not a git repository"))
        s  (slurp-if ex)]
    (fs/create-dirs (fs/parent ex))
    (spit ex (str (when (and s (not (str/blank? s)) (not (str/ends-with? s "\n"))) "\n") "/" path "\n")
          :append true)))


(defn gh-config-dir-in-use
  "Where gh in this process reads its login from."
  []
  (or (not-empty (System/getenv "GH_CONFIG_DIR"))
      (some-> (not-empty (System/getenv "XDG_CONFIG_HOME")) (fs/path "gh") str)
      (expand-home "~/.config/gh")))


(defn gh-login
  "The github.com login stored in a gh config dir, read offline; nil when logged out."
  [dir]
  (some-> (slurp-if (str (fs/path dir "hosts.yml")))
          (yaml/parse-string :keywords false)
          (get-in ["github.com" "user"])))


(defn same-dir? [a b] (= (str (fs/normalize (fs/absolutize a))) (str (fs/normalize (fs/absolutize b)))))


(defn agent-login-problem
  "nil when the agent's gh config holds the agent's login."
  [{:keys [login gh-config-dir]}]
  (let [dir  (expand-home gh-config-dir)
        user (gh-login dir)]
    (cond (nil? user) (str "the agent's gh config " dir " is not logged in")
          (not= login user) (str "the agent's gh config " dir " is logged in as " user ", not " login))))


(defn interactive?
  "A person at a terminal: stdin and stdout are a tty, and this is not a Claude session."
  []
  (and (not (System/getenv "CLAUDECODE"))
       (try (boolean (some-> (System/console) (.isTerminal)))
            (catch Exception _ (some? (System/console))))))


(defn login-agent!
  "Logs the agent's account into its gh config with gh's browser flow, attached to this
  terminal. The person finishes it in the browser, signed in as the agent."
  [{:keys [login gh-config-dir]}]
  (let [dir  (expand-home gh-config-dir)
        opts {:continue true :extra-env {"GH_CONFIG_DIR" dir}}]
    (println (str "\nLogging the agent's GitHub account " login " into " dir ".\n"
                  "On the github.com/login/device page check that you are signed in as " login
                  " (switch account, or use a private window), then enter the code gh shows.\n"))
    (when-let [user (gh-login dir)]
      (p/shell opts "gh" "auth" "logout" "--hostname" "github.com" "--user" user))
    (p/shell opts "gh" "auth" "login" "--hostname" "github.com" "--git-protocol" "https" "--web"
             "--scopes" "project,workflow")))


(defn offer-login!
  "Starts the agent's login when it is missing or wrong and a person is at the terminal."
  [agent]
  (when (and (agent-login-problem agent) (interactive?) (sh "bash" "-c" "command -v gh"))
    (login-agent! agent)))


(defn identity-problems
  "Outside a Claude session: a warning when the agent is not logged in on this machine.
  Inside one (CLAUDECODE is set): gh must act as the agent, never as the owner."
  [cfg]
  (when-let [{:keys [login gh-config-dir] :as agent} (:agent cfg)]
    (let [session? (System/getenv "CLAUDECODE")
          want     (expand-home gh-config-dir)
          have     (gh-config-dir-in-use)
          user     (gh-login have)
          token    (first (filter #(not-empty (System/getenv %)) ["GH_TOKEN" "GITHUB_TOKEN"]))]
      (cond
        (and session? token)
        [[:fail (str token " is set, so gh in this Claude session uses that token, not the agent's account")
          (str "unset " token " in the shell that starts claude, then restart the session")]]

        (and session? (not (same-dir? want have)))
        [[:fail (str "this Claude session runs gh from " have (if user (str ", logged in as " user) ", logged out")
                     ", not from the agent's config " want)
          (if (local-env-problem root (agent-env agent))
            (str mount "/bin/kit init, then restart this Claude session")
            (str "restart this Claude session: " local-settings " is in place and applies at start"))]]

        :else
        (when-let [problem (agent-login-problem agent)]
          [[(if session? :fail :warn) problem
            (str "in your own terminal: " mount "/bin/kit init — it logs " login " in")]])))))


(defn codeowners-text
  [{:keys [owners]}]
  (str "# Managed by dev-kit (`kit init`); the code owners come from :owners in kit.edn.\n"
       "# With \"Require review from Code Owners\" in the main ruleset, a pull request merges only\n"
       "# with the approval of one of them, whoever else approves it.\n"
       "* " (str/join " " (map #(str "@" %) owners)) "\n"))


(def agent-marker
  "<!-- Managed by dev-kit: this copy is rewritten by `kit init`. Edit the original in dev-kit. -->")


(defn agent-text
  [source]
  (let [s (slurp (str source))
        [_ front body] (re-matches #"(?s)(---\n.*?\n---\n)(.*)" s)]
    (str front "\n" agent-marker "\n" body)))


(defn kondo-entry [] (str "../" mount "/clojure/clj-kondo"))
(defn kondo-map-text [] (str "{:config-paths [\"" (kondo-entry) "\"]}"))


(defn managed-items
  "Everything init writes and doctor verifies, derived from kit.edn."
  [cfg]
  (concat
    [{:kind :block :path "AGENTS.md" :content (block-text cfg)}
     {:kind :file :path ".claude/settings.json" :content (settings-text cfg)}
     {:kind :file :path ".github/workflows/ci.yml"
      :content (slurp (str (fs/path kit-dir "managed" "ci.yml")))}
     {:kind :file :path ".github/CODEOWNERS" :content (codeowners-text cfg)}
     {:kind :file :path ".github/ISSUE_TEMPLATE/task.yml"
      :content (slurp (str (fs/path kit-dir "managed" "github" "ISSUE_TEMPLATE" "task.yml")))}
     {:kind :file :path ".github/pull_request_template.md"
      :content (slurp (str (fs/path kit-dir "managed" "github" "pull_request_template.md")))}
     {:kind :file :path ".claude/hooks/pretooluse.sh"
      :content (str/replace (slurp (str (fs/path kit-dir "managed" "pretooluse.sh"))) "{{kit}}" mount)}
     ;; the safety guard's policy (#20): the one file Claude Code, Codex and OpenCode all read
     {:kind :file :path ".cc-safety-net/policy.json" :content (json-text {"version" 1 "safety" {"level" "standard"}})}]
    (when-let [a (:agent cfg)]
      [{:kind :ignored :path local-settings :local true}
       {:kind :local-env :path local-settings :env (agent-env a) :local true}])
    (for [dir (sort (fs/list-dir (fs/path kit-dir "claude" "skills")))
          :when (fs/directory? dir)
          :let [n (str (fs/file-name dir))]]
      {:kind :symlink :path (str ".claude/skills/" n) :target (str "../../" mount "/claude/skills/" n)})
    (for [dir (cond-> [(fs/path kit-dir "claude" "agents")]
                (clojure? cfg) (conj (fs/path kit-dir "claude" "agents" "clojure")))
          f (sort (fs/glob dir "*.md"))]
      {:kind :file :path (str ".claude/agents/" (fs/file-name f)) :content (agent-text f)})
    (when (clojure? cfg)
      [{:kind :symlink :path ".zprint.edn" :target (str mount "/clojure/.zprint.edn")}
       {:kind :kondo :path ".clj-kondo/config.edn"}])
    [{:kind :git-config :key "core.hooksPath" :value (str mount "/githooks") :local true}]))


(defn stale-paths
  "Managed files left over from an older dev-kit version or a module that was switched off."
  [items]
  (let [wanted (set (map :path items))
        links  (for [f (when (fs/directory? (rel ".claude/skills")) (fs/list-dir (rel ".claude/skills")))
                     :when (and (fs/sym-link? f)
                                (str/includes? (str (fs/read-link f)) (str mount "/")))]
                 f)
        agents (for [f (when (fs/directory? (rel ".claude/agents")) (fs/glob (rel ".claude/agents") "*.md"))
                     :when (str/includes? (slurp (str f)) agent-marker)]
                 f)
        zprint (when (and (fs/sym-link? (rel ".zprint.edn"))
                          (str/starts-with? (str (fs/read-link (rel ".zprint.edn"))) (str mount "/")))
                 [(rel ".zprint.edn")])]
    (->> (concat links agents zprint)
         (map #(str (fs/relativize root %)))
         (remove wanted)
         sort)))


;; ------------------------------------------------------------------ checks

(defn block-markers
  "The dev-kit blocks of AGENTS.md text: {:pairs [[first-line last-line] …], :stray [line numbers]}, lines counted
  from 0 in :pairs and from 1 in :stray. A marker is found by its start, so another version's wording still counts."
  [s]
  (loop [[l & more :as ls] (str/split s #"\n" -1) i 0 open nil pairs [] stray []]
    (cond
      (empty? ls) {:pairs pairs :stray (cond-> stray open (conj (inc open)))}
      (str/starts-with? l "<!-- dev-kit:begin") (recur more (inc i) i pairs (cond-> stray open (conj (inc open))))
      (str/starts-with? l "<!-- dev-kit:end") (if open
                                                 (recur more (inc i) nil (conj pairs [open i]) stray)
                                                 (recur more (inc i) nil pairs (conj stray (inc i))))
      :else (recur more (inc i) open pairs stray))))


(defn with-block
  "AGENTS.md text with every dev-kit block removed and content put where the first one was, in the file's line ends."
  [s content pairs]
  (let [content (if (str/includes? s "\r\n") (str (str/replace content "\n" "\r\n") "\r") content) ; lines join on \n
        lines (str/split s #"\n" -1)
        [first-line] (first pairs)
        in-pair? (fn [i] (some (fn [[a b]] (<= a i b)) pairs))]
    (str/join "\n" (concat (subvec lines 0 first-line)
                           [content]
                           (keep-indexed (fn [i l] (when (and (> i first-line) (not (in-pair? i))) l)) lines)))))


(defn block-problem
  "nil when AGENTS.md text holds exactly the dev-kit block content, otherwise the problem."
  [s content]
  (let [{:keys [pairs stray]} (block-markers s)]
    (cond
      (seq stray) (str "line " (str/join ", " stray) " has a dev-kit marker without its pair: delete what is left of the"
                       " old block, or restore the missing marker, then run kit init")
      (empty? pairs) "has no dev-kit block"
      (next pairs) (str "has " (count pairs) " dev-kit blocks")
      (not= s (with-block s content pairs)) "the dev-kit block differs from dev-kit's rules")))


(defn kondo-config
  "The form in a clj-kondo config.edn: nil when it holds none (empty, comments only), ::unreadable when it fails."
  [s]
  (try (edn/read-string s) (catch Exception _ ::unreadable)))


(defn check
  "nil when the item is in place, otherwise a one-line problem."
  [{:keys [kind path content target key value env]}]
  (let [f (some-> path rel)]
    (case kind
      :ignored (ignored-problem root path)

      :local-env (local-env-problem root env)

      :file
      (cond (not (fs/exists? f)) "missing"
            (not= content (slurp-if f)) "differs from what dev-kit generates")

      :block
      (if-let [s (slurp-if f)] (block-problem s content) "missing")

      :symlink
      (cond (not (fs/sym-link? f)) (if (fs/exists? f) "is a real file, not the dev-kit link" "missing")
            (not= target (str (fs/read-link f))) (str "points to " (fs/read-link f) ", expected " target)
            (not (fs/exists? f)) (str "dangling: " target " does not exist"))

      :kondo
      (let [m (some-> (slurp-if f) kondo-config)]
        (cond (not (fs/exists? f)) "missing"
              (= m ::unreadable) "cannot be read: fix it by hand"
              (and (some? m) (not (map? m)))
              (str "is not a map: make it a map, e.g. " (kondo-map-text))
              (not (contains? (set (:config-paths m)) (kondo-entry))) (str ":config-paths lacks \"" (kondo-entry) "\"")))

      :git-config
      (let [v (sh "git" "config" "--local" "--get" key)]
        (when (not= value v) (str "is " (or v "unset") ", expected " value))))))


(defn label
  [{:keys [kind path key]}]
  (if (= kind :git-config) (str "git config " key) path))


(defn submodule-problems
  []
  (let [paths  (some-> (sh "git" "config" "-f" ".gitmodules" "--get-regexp" "path") str/split-lines)
        status (sh "git" "submodule" "status" mount)
        dirty  (sh "git" "-C" mount "status" "--porcelain")]
    (cond-> []
      (not-any? #(str/ends-with? % (str " " mount)) paths)
      (conj [:fail (str mount " is not a submodule of this repository (.gitmodules has no path " mount ")")
             (str "git submodule add https://github.com/shundeev/dev-kit " mount)])

      (some-> status (str/starts-with? "+"))
      (conj [:warn (str mount " is checked out at another commit than the one this repository pins")
             (str "git submodule update " mount ", or commit the bump")])

      (some-> status (str/starts-with? "U"))
      (conj [:fail (str mount " has a merge conflict") "resolve it, then git add " mount])

      (seq dirty)
      (conj [:warn (str mount " has local changes") "commit them in dev-kit, or git -C .shared checkout ."]))))


(def min-claude-version
  "onFailure on hooks needs it; older versions let a failing guard through (ADR-0001, rule 3)."
  [2 1 295])


(defn claude-version-problems
  []
  (when-let [out (sh "bash" "-c" "command -v claude >/dev/null && claude --version")]
    (let [v (some->> (re-find #"(\d+)\.(\d+)\.(\d+)" out) rest (mapv parse-long))]
      (when (and v (neg? (compare v min-claude-version)))
        [[:fail (str "Claude Code " (str/join "." v) " ignores onFailure, so a failing guard would let commands through")
          (str "update Claude Code to " (str/join "." min-claude-version) " or later")]]))))


(defn node-problems
  "The safety guard (#20) runs on Node 22 or later; without it every guarded call is refused."
  []
  (let [v (sh "node" "--version")
        major (some->> v (re-find #"^v(\d+)\.") second parse-long)]
    (when-not (and major (>= major 22))
      [[:fail (str "Node 22 or later is needed for the safety guard, which refuses every guarded call without it ("
                   (or v "node not found") ")")
        "install Node 22 or later (e.g. nvm install 22), then restart the Claude session"]])))


(defn tool-problems
  [cfg]
  (concat
    (for [[tool why] (cond-> [["git" "everything"]
                              ["gh" "the issue flow scripts"]
                              ["jq" "the delivery-guard hook and flow scripts"]]
                       (clojure? cfg) (into [["clj-kondo" "lint"] ["zprint" "format check"]]))
          :when (nil? (sh "bash" "-c" (str "command -v " tool)))]
      [:fail (str tool " is not installed (needed for " why ")") (str "install " tool)])
    (node-problems)))


(defn ownership-problems
  "Where init would replace what dev-kit did not write (#14): a file that is neither what dev-kit writes nor marked
  as dev-kit's, a real file where a link goes, a hooks path of another tool. JSON carries no marker: a JSON file of
  dev-kit's counts by its content (#20), and .claude/settings.json found before the first init moves into kit.edn."
  [items]
  (for [{:keys [kind path key value content] :as item} items
        :let [f       (some-> path rel)
              problem (case kind
                        :file (when (and (fs/regular-file? f) (not= path ".claude/settings.json") (not= content (slurp f))
                                         (not (str/includes? (slurp f) "Managed by dev-kit")))
                                (if (str/starts-with? path ".claude/agents/")
                                  "is an agent of the project's own with dev-kit's name: rename it"
                                  "holds a file dev-kit did not write: move it away, or merge what it needs elsewhere"))
                        :symlink (when (and (fs/exists? f) (not (fs/sym-link? f)))
                                   (str "is a real " (if (fs/directory? f) "folder" "file") " where dev-kit puts a link to "
                                        (:target item) ": move it away"))
                        :git-config (let [v (sh "git" "config" "--local" "--get" key)]
                                      (when (and v (not= v value))
                                        (str "is " v ": call those hooks from " value " or drop them, then git config --unset " key)))
                        nil)]
        :when problem]
    (str (label item) " " problem "; then run kit init again")))


(defn user-reads-both?
  "Whether the user's Claude Code settings load AGENTS.md next to CLAUDE.md files (Project instructions)."
  []
  (let [m (read-json-object (expand-home "~/.claude/settings.json"))]
    (some #(= "claude-md-and-agents-md" (get-in m ["pluginConfigs" % "options" "instructionFiles"]))
          ["cc-plugin-agents-md@builtin" "agents-md@builtin"])))


(defn claude-md-problems
  "Claude Code reads AGENTS.md only when no CLAUDE.md, .claude/CLAUDE.md or CLAUDE.local.md is in the project or
  above it; the user's own ~/.claude/CLAUDE.md does not count
  (https://code.claude.com/docs/en/memory#when-claude-code-reads-agents-md). --ci looks at the committed files only."
  [ci]
  (let [real  #(str (fs/real-path %))
        user  (let [u (expand-home "~/.claude/CLAUDE.md")] (when (fs/exists? u) (real u)))
        found (distinct
                (for [d (if ci [root] (take-while some? (iterate fs/parent (fs/real-path root))))
                      f (if ci ["CLAUDE.md" ".claude/CLAUDE.md"] ["CLAUDE.md" ".claude/CLAUDE.md" "CLAUDE.local.md"])
                      :let [p (fs/path d f)]
                      :when (and (fs/exists? p) (not= (real p) user))]
                  (real p)))]
    (when (and (seq found) (or ci (not (user-reads-both?))))
      [[:fail (str (str/join ", " found) " hides AGENTS.md: Claude Code then never reads the rules")
        "move its content into AGENTS.md below the dev-kit block and delete it, or set Project instructions to claude-md-and-agents-md in /config"]])))


(defn problems
  [cfg {:keys [ci]}]
  (cond
    (nil? cfg)
    [[:fail "kit.edn is missing" (str mount "/bin/kit init --repo <owner/repo> --showcase <name>")]]

    (seq (config-problems cfg))
    (for [p (config-problems cfg)] [:fail (str "kit.edn: " p) "fix kit.edn"])

    :else
    (concat
      (claude-md-problems ci)
      (submodule-problems)
      (for [item (managed-items cfg)
            :when (not (and ci (:local item)))
            :let [problem (check item)]
            :when problem]
        [:fail (str (label item) ": " problem) (str mount "/bin/kit init")])
      (for [p (stale-paths (managed-items cfg))]
        [:fail (str p ": left over from dev-kit, no longer managed") (str mount "/bin/kit init")])
      (when-not ci (concat (tool-problems cfg) (claude-version-problems) (identity-problems cfg))))))


;; ------------------------------------------------------------------ init

(defn write!
  [path content]
  (fs/create-dirs (fs/parent path))
  (spit (str path) content))


(defn fix!
  "Brings one managed item in place. Returns a description when something changed."
  [{:keys [kind path content target key value env] :as item}]
  (when-let [problem (check item)]
    (let [f (some-> path rel)]
      (case kind
        :file (write! f content)

        :ignored (ignore! root path)

        :local-env (write-local-env! root env)

        :block
        (let [s (slurp-if f)
              {:keys [pairs stray]} (some-> s block-markers)]
          (cond
            (nil? s) (write! f (str content "\n" (slurp (str (fs/path kit-dir "scaffold" "AGENTS.md")))))
            (seq stray) (fail! problem)
            (empty? pairs) (write! f (str content "\n\n" s))
            :else (write! f (with-block s content pairs))))

        :symlink
        (if (and (fs/exists? f) (not (fs/sym-link? f)))
          (fail! path "is a real file where dev-kit wants a link; move it away, then run init again")
          (do (fs/delete-if-exists f)
              (fs/create-dirs (fs/parent f))
              (fs/create-sym-link f target)))

        :kondo
        (let [s (slurp-if f)
              m (some-> s kondo-config)
              entry (str (kondo-map-text) "\n")]
          (cond
            (nil? s) (write! f (str ";; Project settings for clj-kondo. Shared strict linters come from dev-kit.\n" entry))
            (nil? m) (write! f (str s (when-not (str/ends-with? s "\n") "\n") entry)) ; empty, or comments only
            (not (map? m)) (fail! path problem)
            :else (let [zloc (z/of-string s)]
                    (write! f (z/root-string (if (z/get zloc :config-paths)
                                               (z/edit (z/get zloc :config-paths) conj (kondo-entry))
                                               (z/assoc zloc :config-paths [(kondo-entry)]))))))
          (when (check item) (fail! path "could not be updated; add" (kondo-entry) "to :config-paths by hand")))

        :git-config (sh "git" "config" "--local" key value))
      (str (label item) " (" problem ")"))))


(defn origin-repo
  "owner/name of the GitHub origin of the git repository at dir, or nil."
  [dir]
  (when-let [url (sh-in dir "git" "remote" "get-url" "origin")]
    (second (re-find #"github\.com[:/]([^/]+/[^/]+?)(?:\.git)?/?$" url))))


(defn new-config
  "The kit.edn a project without one gets, from init's flags. A .claude/settings.json already there becomes
  :claude-settings, which the generated settings merge in: nothing of it is lost."
  [{:keys [repo showcase modules]}]
  (let [settings (read-json-object (rel ".claude/settings.json"))
        ;; settings dev-kit wrote run its hook; kit.edn went missing, they are not the project's own
        settings (if (str/includes? (json/generate-string settings) ".claude/hooks/pretooluse.sh") {} settings)]
    (when (= ::invalid settings) (fail! ".claude/settings.json is not a JSON object: fix it or move it away, then run kit init again"))
    (cond-> {:repo     (or repo (origin-repo root) (fail! "no origin remote on GitHub: pass --repo owner/name"))
             :showcase showcase
             :modules  (into #{} (comp (remove str/blank?) (map keyword)) (some-> modules (str/split #",")))}
      (seq settings) (assoc :claude-settings settings))))


(defn create-config!
  [{:keys [repo showcase modules claude-settings]}]
  (write! config-file
          (str ";; dev-kit settings for this project, read by " mount "/bin/kit (see " mount "/README.md).\n"
               "{:repo     " (pr-str repo) "\n"
               " :showcase " (pr-str showcase) "\n"
               " ;; #{:clojure} adds the shared zprint/clj-kondo setup and Clojure rules\n"
               " :modules  " (pr-str modules)
               (when claude-settings
                 (str "\n ;; merged into the generated .claude/settings.json; it was the project's own before dev-kit\n"
                      " :claude-settings " (pr-str claude-settings)))
               "}\n")))


(defn scaffold!
  [cfg all?]
  (let [repo  (:repo cfg)
        vars  {"{{year}}" (str (.getYear (java.time.LocalDate/now)))
               "{{repo}}" repo
               "{{name}}" (last (str/split repo #"/"))
               "{{dir}}"  (last (str/split repo #"/"))}
        files (cond-> ["LICENSE"]
                all? (into ["README.md" "adr/README.md" "docs/experiments/README.md"]))]
    (doall
      (for [f files
            :when (not (fs/exists? (rel f)))]
        (do (write! (rel f) (reduce-kv str/replace (slurp (str (fs/path kit-dir "scaffold" f))) vars))
            (str f " (created)"))))))


;; ------------------------------------------------------------------ commands

(defn print-problems
  [ps quiet]
  (doseq [[level msg fix] ps]
    (println (format "  %-4s  %s  →  %s" (if (= level :fail) "FAIL" "WARN") msg fix)))
  (when (and (empty? ps) (not quiet))
    (println "  ok    everything in place")))


(defn doctor
  [{:keys [quiet] :as opts}]
  (let [ps (problems (read-config) opts)]
    (when (or (seq ps) (not quiet))
      (when-not quiet (println "dev-kit doctor" (str "(" root ")")))
      (print-problems ps quiet))
    (System/exit (if (some #(= :fail (first %)) ps) 1 0))))


(defn init-local
  "Per-machine items only (settings.local.json, local git config), never a committed file:
  the SessionStart hook runs it, so a fresh clone or worktree sets itself up."
  []
  (when-let [cfg (read-config)]
    (when (empty? (config-problems cfg)) ; doctor names them; the session start does not repeat it
      (doseq [c (keep fix! (filter :local (managed-items cfg)))]
        (println "dev-kit init --local: wrote" c)))))


(defn refuse!
  "Prints why init writes nothing, and exits 1."
  [ps]
  (println "dev-kit init" (str "(" root ")"))
  (doseq [p ps] (println (str "  FAIL  " p)))
  (println "  nothing was written")
  (System/exit 1))


(defn init
  "Writes nothing until kit.edn is valid and no project file sits where dev-kit writes; then brings every item in
  place on its own, so one that fails leaves the others done (#14)."
  [opts]
  (let [new     (when-not (fs/exists? config-file) (new-config opts))
        cfg     (if new (merge-config (read-defaults) new) (read-config))
        _       (some-> (seq (config-problems cfg)) refuse!)
        items   (managed-items cfg)
        _       (some-> (seq (ownership-problems items)) refuse!)
        _       (when new (create-config! new))
        stale   (stale-paths items)
        _       (run! #(fs/delete-if-exists (rel %)) stale)
        results (doall (for [item items]
                         (try [:ok (fix! item)]
                              (catch clojure.lang.ExceptionInfo e [:fail (str (label item) ": " (ex-message e)) (label item)]))))
        failed  (set (keep (fn [[l _ lbl]] (when (= l :fail) lbl)) results))
        changes (concat (when (:claude-settings new)
                          ["kit.edn :claude-settings (the project's .claude/settings.json, which is generated from now on)"])
                        (scaffold! cfg (:scaffold opts))
                        (keep (fn [[l c]] (when (= l :ok) c)) results)
                        (map #(str % " (removed, no longer managed)") stale))]
    (println "dev-kit init" (str "(" root ")"))
    (doseq [c changes] (println "  wrote" c))
    (doseq [[l msg] results :when (= l :fail)] (println (str "  FAIL  " msg)))
    (when (and (empty? changes) (empty? failed)) (println "  nothing to change"))
    (some-> (:agent cfg) offer-login!)
    ;; doctor's view of what is left, without repeating the items that failed above
    (let [ps (remove (fn [[_ msg]] (some #(str/starts-with? msg (str % ": ")) failed)) (problems cfg {}))]
      (print-problems ps false)
      (System/exit (if (or (seq failed) (some #(= :fail (first %)) ps)) 1 0)))))


(defn identity!
  "Writes the agent identity into dir's settings.local.json: dev-kit itself, or a repository
  that does not mount dev-kit yet. Uses dir's kit.edn when it has one, else the defaults."
  [{:keys [dir]}]
  (let [dir  (str (fs/normalize (fs/absolutize (or dir root))))
        _    (when-not (and (fs/directory? dir) (= (str (fs/real-path dir)) (sh-in dir "git" "rev-parse" "--show-toplevel")))
               (die dir "is not the root of a git repository"))
        cfg  (merge (read-defaults) (some-> (slurp-if (str (fs/path dir "kit.edn"))) edn/read-string))
        agent (or (:agent cfg) (die "no :agent in kit.edn or dev-kit's defaults; add :agent {:login \"<the agent's GitHub login>\" :email \"<its noreply email>\" :gh-config-dir \"~/.config/gh-agent\"} to kit.edn"))
        env  (agent-env agent)
        done (cond-> []
               (ignored-problem dir local-settings)   (conj (do (ignore! dir local-settings) "ignored"))
               (local-env-problem dir env)            (conj (do (write-local-env! dir env) "wrote")))]
    (println "dev-kit identity" (str "(" dir ")"))
    (println (if (seq done)
               (str "  " (str/join ", " done) " " local-settings " — restart Claude sessions here to use it")
               "  nothing to change"))
    (offer-login! agent)
    (when-let [problem (agent-login-problem agent)]
      (println (str "  WARN  " problem "  →  in your own terminal: bb " (fs/path kit-dir "bin" "kit")
                    " identity --dir " dir " — it logs " (:login agent) " in")))))

;; ------------------------------------------------------------------ gate (ADR-0002, #26, #21)
;; The pull request gate, in CI: `kit gate --branch … --pr …`. In order:
;; - shape (#21): the branch is `<n>-<slug>` of an open issue, the title `type(GH-n): summary`, the
;;   body has an `ADR:` line and filled **Review** and **User-level test** sections; the finish
;;   script runs the same rules offline (`kit gate --shape`) before it opens the PR;
;; - accepted ADRs (`adr/NNNN-*.md` on the base) are not modified, removed or renamed;
;; - G1: an M or L issue, or one without a `size:*` label, needs `design-approved`, added after the
;;   issue body and its `## Design` comments last changed, by someone with write access who is not
;;   the agent. An XS/S pull request stays within a size threshold.
;; The PreToolUse hook runs `kit gate --hook` before Edit/Write.

(def size-threshold
  "Lines changed in an XS/S pull request, lock and kit-managed files not counted. Merged before the
  gate (#26): S PRs 0–160 lines (dev-kit#43 the largest), M PRs 53–467. 200 sits above every S so
  far: it catches a clearly under-sized S, not every M."
  200)


(def lock-file #"(^|/)(package-lock\.json|yarn\.lock|pnpm-lock\.yaml|[^/]+\.lock)$")


(def commit-types ["build" "chore" "ci" "docs" "feat" "fix" "perf" "refactor" "test"])


(defn branch-issue
  "The issue number of a `<n>-<slug>` branch, or nil."
  [branch]
  (second (re-find #"^(\d+)-" (str branch))))


(defn report!
  "Prints [level message] lines as `ok`/`FAIL`; exits 1 when one failed."
  [verdicts]
  (doseq [[level msg] verdicts]
    (println (str (if (= level :ok) "  ok    " "  FAIL  ") msg)))
  (when (some #(not= :ok (first %)) verdicts) (System/exit 1)))


(defn section-text
  "The text under `## <heading>` up to the next heading or the ADR line, without the template's
  `<!-- … -->` hints; nil when the body has no such heading."
  [body heading]
  (when-let [[_ text] (re-find (re-pattern (str "(?ms)^## " (java.util.regex.Pattern/quote heading)
                                                "[ \\t]*$(.*?)(?=^## |^ADR:|\\z)"))
                               body)]
    (str/trim (str/replace text #"(?s)<!--.*?-->" ""))))


(defn shape-problems
  "What is wrong with a pull request's branch, title and body, each with its fix (#21). Offline, so
  the finish script checks before it opens the PR what CI checks after. A nil body is not checked."
  [branch title body pr]
  (if-let [n (branch-issue branch)]
    (cond-> []
      (not (re-matches (re-pattern (str "(?:" (str/join "|" commit-types) ")\\(GH-" n "\\): \\S.*")) (str title)))
      (conj (str "the title '" title "' is not '<type>(GH-" n "): <summary>' with a type from " (str/join ", " commit-types)
                 ": " (if pr
                        (str "rename it: gh pr edit " pr " --title '<type>(GH-" n "): <summary>'")
                        "pass --type from that list, or fix the first line of the commit message")))

      (and body (not (re-find #"(?m)^ADR: +(?:none|adr/\d{4}-\S+\.md)\b" body)))
      (conj "the body has no 'ADR: none' or 'ADR: adr/NNNN-….md' line: add one (adr skill); a reason may follow it")

      body
      (into (for [heading ["Review" "User-level test"]
                  :let [text (section-text body heading)]
                  :when (str/blank? text)]
              (if (nil? text)
                (str "the body has no line '## " heading "' (exactly that heading): add the section from the PR template")
                (str "'## " heading "' is empty, or holds only the template's hint: fill in ## " heading
                     "; CI reruns when the body is edited")))))
    [(str "branch '" branch "' is not <issue>-<slug>: open the issue with start_issue_flow.sh and move the work to its branch")]))


(defn adr-problems
  "Accepted ADRs, `adr/NNNN-*.md` that exist on the base, which the pull request's files change."
  [files]
  (for [{:strs [filename status previous_filename]} files
        :let [f (if (= status "renamed") previous_filename filename)]
        :when (and (#{"modified" "changed" "removed" "renamed"} status) (re-matches #"adr/\d{4}-[^/]+\.md" (str f)))]
    (str f " was " status ", but accepted ADRs are immutable: revert it, and record the change as a new ADR with "
         "'Supersedes: ADR-" (subs f 4 8) "' (adr skill)")))


(defn gh!
  "Runs gh; stdout, or an exception carrying gh's message."
  [& args]
  (let [{:keys [exit out err]} (apply p/sh {:continue true} "gh" args)]
    (if (zero? exit) out (throw (ex-info (str/trim (str err out)) {})))))


(def issue-query
  (str "query($o:String!,$n:String!,$i:Int!){repository(owner:$o,name:$n){issue(number:$i){"
       "state lastEditedAt labels(first:50){nodes{name}}"
       " timelineItems(itemTypes:[LABELED_EVENT],last:50){nodes{... on LabeledEvent{actor{login} label{name} createdAt}}}"
       " comments(last:100){nodes{author{login} body createdAt lastEditedAt}}}}}"))


(defn fetch-issue
  [repo n]
  (let [[o r] (str/split repo #"/")]
    (get-in (json/parse-string (gh! "api" "graphql" "-f" (str "query=" issue-query)
                                    "-f" (str "o=" o) "-f" (str "n=" r) "-F" (str "i=" n)))
            ["data" "repository" "issue"])))


(defn issue-size
  "The issue's size label (\"XS\" … \"XL\"), or nil."
  [issue]
  (some #(second (re-matches #"size:(XS|S|M|L|XL)" (get % "name"))) (get-in issue ["labels" "nodes"])))


(defn g1-verdict
  "[:ok msg] or [:fail reason-with-fix] for the design approval of issue n."
  [repo n issue agent]
  (let [labels  (set (map #(get % "name") (get-in issue ["labels" "nodes"])))
        event   (->> (get-in issue ["timelineItems" "nodes"])
                     (filter #(= "design-approved" (get-in % ["label" "name"])))
                     (sort-by #(get % "createdAt"))
                     last)
        by      (get-in event ["actor" "login"])
        at      (get event "createdAt")
        later?  (fn [t] (and t at (pos? (compare t at))))
        redo    (str "; the owner approves again: remove `design-approved` from #" n " and add it back")
        changed (some #(and (str/starts-with? (str (get % "body")) "## Design")
                            (or (later? (get % "createdAt")) (later? (get % "lastEditedAt"))))
                      (get-in issue ["comments" "nodes"]))]
    (cond
      (not (labels "design-approved"))
      [:fail (str "#" n " has no `design-approved`: code waits until the owner approves the design by adding it")]

      (nil? event) [:fail (str "#" n " carries `design-approved` but GitHub shows no event for it" redo)]

      (= by agent)
      [:fail (str "`design-approved` on #" n " was set by the agent (" by "); only a person with write access approves" redo)]

      (not (#{"write" "maintain" "admin"}
            (str/trim (gh! "api" (str "repos/" repo "/collaborators/" by "/permission") "--jq" ".permission"))))
      [:fail (str "`design-approved` on #" n " was set by " by ", who has no write access" redo)]

      (later? (get issue "lastEditedAt"))
      [:fail (str "the body of #" n " was edited after the approval (" at ")" redo)]

      changed [:fail (str "a `## Design` comment on #" n " changed after the approval (" at ")" redo)]

      :else [:ok (str "G1: design of #" n " approved by " by " at " at)])))


(defn gate-config [] (merge (read-defaults) (or (read-config) {})))


(defn gate-repo
  "The repository gate and retro act on: --repo, CI's, the current folder's origin, then the session's
  GHWF_REPO and kit.edn. The folder comes before the session (#81)."
  [{:keys [repo]} cfg]
  (or repo (not-empty (System/getenv "GITHUB_REPOSITORY")) (origin-repo ".") (not-empty (System/getenv "GHWF_REPO"))
      (:repo cfg)
      (die "no repository: this folder has no GitHub origin and GHWF_REPO is not set; run inside the clone, or pass --repo owner/name")))


(defn managed-paths
  "Files kit generates in this project: not counted towards a PR's size."
  [cfg]
  (if (read-config)
    (into #{(str mount)} (keep #(when (#{:file :symlink} (:kind %)) (:path %)) (managed-items cfg)))
    #{}))


(defn pr-files
  "Every file of the pull request, all pages: one JSON object per line from gh."
  [repo pr]
  (->> (gh! "api" (str "repos/" repo "/pulls/" pr "/files?per_page=100") "--paginate"
            "--jq" ".[] | {filename, status, previous_filename, additions, deletions}")
       str/split-lines
       (remove str/blank?)
       (map json/parse-string)))


(defn pr-lines
  [files excluded]
  (->> files
       (remove #(let [f (get % "filename")] (or (re-find lock-file f) (excluded f))))
       (map #(+ (get % "additions" 0) (get % "deletions" 0)))
       (reduce + 0)))


(defn issue-verdict
  "[level message] for the issue behind the pull request: open, and its design approval or size."
  [repo n files cfg]
  (let [issue (try (fetch-issue repo n) (catch Exception e {"error" (ex-message e)}))
        size  (issue-size issue)]
    (cond
      (or (nil? issue) (get issue "error"))
      [:fail (str "#" n " is not an issue of " repo (some->> (get issue "error") (str ": "))
                  "; the branch must start with the number of the PR's issue")]

      (not= "OPEN" (get issue "state"))
      [:fail (str "#" n " is closed: reopen it, or move the work to the branch of an open issue")]

      (#{"XS" "S"} size)
      (let [lines (pr-lines files (managed-paths cfg))]
        (if (<= lines size-threshold)
          [:ok (str "size " size ": " lines " lines changed, within " size-threshold
                    " (lock and kit-managed files not counted); G1 not required")]
          [:fail (str "#" n " is size:" size " but the PR changes " lines " lines (over " size-threshold
                      "): resize #" n " to size:M on the board and its label, post the design, and the owner approves it")]))

      :else
      (let [[l m] (g1-verdict repo n issue (get-in cfg [:agent :login]))]
        [l (str (if size (str "size " size) "no size label, so M") "; " m)]))))


(defn gate-ci!
  [{:keys [branch pr] :as opts}]
  (let [cfg    (gate-config)
        repo   (gate-repo opts cfg)
        branch (or branch (not-empty (System/getenv "GITHUB_HEAD_REF")) (die "gate: pass --branch"))
        pr     (or pr (die "gate: pass --pr"))
        n      (branch-issue branch)
        read!  #(try (%) (catch Exception e (report! [[:fail (str "could not read PR #" pr " of " repo " from GitHub ("
                                                                  (ex-message e) "); rerun the job")]])))
        {:strs [title body]} (read! #(json/parse-string (gh! "api" (str "repos/" repo "/pulls/" pr) "--jq" "{title, body}")))
        files  (read! #(doall (pr-files repo pr)))]
    (report! (concat (for [p (concat (shape-problems branch title (str body) pr) (adr-problems files))] [:fail p])
                     (when n [(issue-verdict repo n files cfg)])))))


(defn gate-shape!
  "The shape rules alone, offline, for the finish script before it commits and opens the PR."
  [{:keys [branch title body-file]}]
  (report! (for [p (shape-problems branch title (some-> body-file slurp) nil)] [:fail p])))


(defn gate-g1!
  "The design approval of one issue, as the hook and a person need it."
  [n opts]
  (let [cfg   (gate-config)
        repo  (gate-repo opts cfg)
        issue (fetch-issue repo n)
        size  (issue-size issue)]
    (if (#{"XS" "S"} size)
      [:ok (str "#" n " is size " size "; G1 not required")]
      (g1-verdict repo n issue (get-in cfg [:agent :login])))))


(defn gate-hook!
  "PreToolUse for Edit/Write/NotebookEdit: on an issue branch, outside adr/, refuses an edit while the
  design approval is missing. Verdicts are cached for 10 minutes; GitHub unreachable means refused."
  [opts]
  (let [input  (json/parse-string (slurp *in*))
        file   (or (get-in input ["tool_input" "file_path"]) (get-in input ["tool_input" "notebook_path"]))
        top    (sh-in "." "git" "rev-parse" "--show-toplevel")
        branch (sh-in "." "git" "rev-parse" "--abbrev-ref" "HEAD")
        n      (branch-issue branch)
        path   (when (and top file) (str (fs/relativize top (fs/absolutize file))))]
    (when (and n (not (str/starts-with? (str path) "adr/")))
      (let [cache (str (fs/absolutize (sh-in "." "git" "rev-parse" "--git-path" (str "kit/g1-" n))))
            now   (quot (System/currentTimeMillis) 1000)
            [t level reason] (some-> (slurp-if cache) (str/split #" " 3))
            [level reason]
            (if (and t (< (- now (parse-long t)) 600))
              [(keyword level) reason]
              (try (let [[l r] (gate-g1! n opts)]
                     (fs/create-dirs (fs/parent cache))
                     (spit cache (str now " " (name l) " " r))
                     [l r])
                   (catch Exception e
                     [:error (str "could not check the design approval of #" n " (" (ex-message e)
                                  "); retry, or check by hand: kit gate --g1 " n)])))]
        (when (not= level :ok)
          (println (json/generate-string
                     {:hookSpecificOutput {:hookEventName "PreToolUse" :permissionDecision "deny"
                                           :permissionDecisionReason (str "Refused: " reason)}})))))))


(defn gate!
  [{:keys [g1 hook shape] :as opts}]
  (cond
    hook (gate-hook! opts)
    shape (gate-shape! opts)
    g1   (report! [(try (gate-g1! g1 opts) (catch Exception e [:fail (ex-message e)]))])
    :else (gate-ci! opts)))



(defn parse-args
  [args]
  (loop [[a & more] args opts {}]
    (case a
      nil opts
      "--repo" (recur (rest more) (assoc opts :repo (first more)))
      "--showcase" (recur (rest more) (assoc opts :showcase (first more)))
      "--modules" (recur (rest more) (assoc opts :modules (first more)))
      "--scaffold" (recur more (assoc opts :scaffold true))
      "--ci" (recur more (assoc opts :ci true))
      "--quiet" (recur more (assoc opts :quiet true))
      "--dir" (recur (rest more) (assoc opts :dir (first more)))
      "--local" (recur more (assoc opts :local true))
      "--branch" (recur (rest more) (assoc opts :branch (first more)))
      "--pr" (recur (rest more) (assoc opts :pr (first more)))
      "--g1" (recur (rest more) (assoc opts :g1 (first more)))
      "--hook" (recur more (assoc opts :hook true))
      "--shape" (recur more (assoc opts :shape true))
      "--title" (recur (rest more) (assoc opts :title (first more)))
      "--body-file" (recur (rest more) (assoc opts :body-file (first more)))
      "--now" (recur (rest more) (assoc opts :now (first more)))
      "--messages" (recur more (assoc opts :messages true))
      (die "unknown option" a))))


(defn usage
  []
  (println (str/join "\n" (->> (str/split-lines (slurp *file*))
                               (drop 1)
                               (take-while #(str/starts-with? % ";;"))
                               (map #(str/replace % #"^;; ?" ""))))))


(defn retro!
  "kit retro N … and kit retro --missing …: the code lives in bin/retro.clj, loaded only for this command."
  [[n & more]]
  (when-not (and n (or (= n "--missing") (re-matches #"\d+" n)))
    (die "retro: name the issue, e.g. kit retro 55, or kit retro --missing"))
  (load-file (str (fs/path kit-dir "bin" "retro.clj")))
  (let [opts (parse-args more)
        opts (assoc opts :repo (gate-repo opts (gate-config)) :gh gh!)]
    (if (= n "--missing")
      ((resolve 'retro/run-missing) opts)
      ((resolve 'retro/run) (assoc opts :issue (parse-long n) :agent (get-in (read-defaults) [:agent :login]))))))


(let [[cmd & args] *command-line-args*]
  (when (and (#{"init" "doctor" "modules"} cmd)
             (not= (str root) (sh "git" "rev-parse" "--show-toplevel")))
    (die "dev-kit must be mounted at <project>/" mount "; " (str root) "is not a git repository root"))
  (try
    (case cmd
      "init" (let [opts (parse-args args)] (if (:local opts) (init-local) (init opts)))
      "doctor" (doctor (parse-args args))
      "modules" (let [cfg (read-config)]
                  (println (str "clojure=" (boolean (some-> cfg clojure?))))
                  (println (str "user_test=" (boolean (get-in cfg [:user-test :run]))))
                  (println (str "user_test_artifacts=" (or (get-in cfg [:user-test :artifacts]) ""))))
      "user-test" (user-test!)
      "identity" (identity! (parse-args args))
      "gate" (gate! (parse-args args))
      "retro" (retro! args)
      nil (usage)
      (do (usage) (die "unknown command" cmd)))
    (catch clojure.lang.ExceptionInfo e
      (if (:kit/problem (ex-data e))
        (do (println (str "  FAIL  " (ex-message e))) (System/exit 1))
        (throw e)))))
